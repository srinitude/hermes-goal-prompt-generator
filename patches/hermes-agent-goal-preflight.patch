@@ -0,0 +1,75 @@
+from __future__ import annotations
+
+from queue import Queue
+from types import SimpleNamespace
+
+
+class _FakeGoalManager:
+    def __init__(self):
+        self.goal = None
+        self.kwargs = None
+
+    def set(self, goal, **kwargs):
+        self.goal = goal
+        self.kwargs = kwargs
+        return SimpleNamespace(max_turns=20, goal=goal, **kwargs)
+
+    def status_line(self):
+        return "No active goal."
+
+    def pause(self, reason="user-paused"):
+        return None
+
+    def resume(self):
+        return None
+
+    def has_goal(self):
+        return False
+
+    def clear(self):
+        return None
+
+
+def _fake_cli(manager):
+    return SimpleNamespace(
+        _get_goal_manager=lambda: manager,
+        _pending_input=Queue(),
+    )
+
+
+def test_cli_goal_command_preflights_raw_prompt(tmp_path, monkeypatch):
+    import cli as cli_module
+    from cli import HermesCLI
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(cli_module, "_cprint", lambda *a, **kw: None)
+    manager = _FakeGoalManager()
+    fake = _fake_cli(manager)
+
+    HermesCLI._handle_goal_command(fake, "/goal Build a FastAPI API with tests")
+
+    assert manager.goal is not None
+    assert manager.goal != "Build a FastAPI API with tests"
+    assert "generated_by: goal-prompt-generator" in manager.goal
+    assert "## Software Development Constraints" in manager.goal
+    assert manager.kwargs["optimized_by"] == "goal-prompt-generator"
+    assert manager.kwargs["goal_file"].endswith(".md")
+    assert fake._pending_input.get_nowait() == manager.goal
+
+
+def test_cli_goal_command_reuses_valid_optimized_file(tmp_path, monkeypatch):
+    import cli as cli_module
+    from cli import HermesCLI
+    from hermes_cli.goal_prompt_generator import prepare_goal_prompt
+
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr(cli_module, "_cprint", lambda *a, **kw: None)
+    optimized = prepare_goal_prompt("Create a Python package with tests")
+    manager = _FakeGoalManager()
+    fake = _fake_cli(manager)
+
+    HermesCLI._handle_goal_command(fake, f"/goal {optimized.file_path}")
+
+    assert manager.goal == optimized.goal_text
+    assert manager.kwargs["goal_file"] == str(optimized.file_path)
+    assert len(list(tmp_path.glob("*.md"))) == 1

