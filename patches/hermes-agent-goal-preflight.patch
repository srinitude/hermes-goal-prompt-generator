@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from datetime import datetime
+from unittest.mock import MagicMock
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.platforms.base import MessageEvent
+from gateway.session import SessionEntry, SessionSource, build_session_key
+
+
+def _source() -> SessionSource:
+    return SessionSource(
+        platform=Platform.TELEGRAM,
+        user_id="u1",
+        chat_id="c1",
+        user_name="tester",
+        chat_type="dm",
+    )
+
+
+def _event(text: str) -> MessageEvent:
+    return MessageEvent(text=text, source=_source(), message_id="m1")
+
+
+@pytest.fixture()
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.chdir(tmp_path)
+
+    from hermes_cli import goals
+
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+def _runner():
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(
+        platforms={Platform.TELEGRAM: PlatformConfig(enabled=True, token="***")}
+    )
+    runner.adapters = {Platform.TELEGRAM: MagicMock()}
+    session = SessionEntry(
+        session_key=build_session_key(_source()),
+        session_id="gateway-goal-session-1",
+        created_at=datetime.now(),
+        updated_at=datetime.now(),
+        platform=Platform.TELEGRAM,
+        chat_type="dm",
+    )
+    runner.session_store = MagicMock()
+    runner.session_store.get_or_create_session.return_value = session
+    runner._session_key_for_source = GatewayRunner._session_key_for_source.__get__(runner, GatewayRunner)
+    runner._enqueue_fifo = MagicMock()
+    return runner
+
+
+@pytest.mark.asyncio
+async def test_gateway_goal_preflights_raw_prompt_before_queueing(hermes_home):
+    runner = _runner()
+    out = await runner._handle_goal_command(_event("/goal Build a FastAPI API with tests"))
+
+    assert "Goal set" in out
+    assert "Optimized goal file" in out
+    runner._enqueue_fifo.assert_called_once()
+    kickoff_event = runner._enqueue_fifo.call_args.args[1]
+    assert kickoff_event.text.startswith("---\ngenerated_by: goal-prompt-generator")
+    assert "## Non-Execution Guardrail" in kickoff_event.text
+    assert "## Software Development Constraints" in kickoff_event.text
+    assert kickoff_event.text != "Build a FastAPI API with tests"
+
+    from hermes_cli.goal_prompt_generator import validate_optimized_markdown
+    from hermes_cli.goals import GoalManager
+
+    state = GoalManager("gateway-goal-session-1").state
+    assert state is not None
+    assert state.goal == kickoff_event.text
+    assert state.optimized_by == "goal-prompt-generator"
+    assert state.goal_file and state.goal_file.endswith("fastapi-api-tests-goal.md")
+    assert validate_optimized_markdown(state.goal).valid
+
+
+@pytest.mark.asyncio
+async def test_gateway_goal_reuses_valid_optimized_file(hermes_home, tmp_path):
+    from hermes_cli.goal_prompt_generator import prepare_goal_prompt
+
+    optimized = prepare_goal_prompt("Create a Python CLI for invoices", execution_dir=tmp_path)
+    runner = _runner()
+
+    out = await runner._handle_goal_command(_event(f"/goal {optimized.file_path}"))
+
+    assert "reused" in out
+    runner._enqueue_fifo.assert_called_once()
+    kickoff_event = runner._enqueue_fifo.call_args.args[1]
+    assert kickoff_event.text == optimized.goal_text.strip()
+
+    from hermes_cli.goals import GoalManager
+
+    state = GoalManager("gateway-goal-session-1").state
+    assert state is not None
+    assert state.goal_file == str(optimized.file_path)
+    assert state.goal == optimized.goal_text.strip()
